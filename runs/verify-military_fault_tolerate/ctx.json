    },
    "steps": [
      {
        "id": "check_env",
        "name": "检查环境",
        "action": "k8s.check_ready",
        "params": {
          "services": [
            "orchestrator",
            "scenario-mgr",
            "entity-service",
            "comms-service",
            "sensor-service",
            "fire-control",
            "env-service",
