        "params": {
          "algo": "fault_detect_dl"
        },
        "timeout": 180
      },
      {
        "id": "measure_latency",
        "name": "计算故障感知延迟",
        "action": "measure.detect_latency",
        "timeout": 10
      },
      {
        "id": "trace",
        "name": "采集真实 Trace（服务级指标 + 运行态依赖图）",
        "action": "trace.collect",
        "params": {
          "lookback_s": "${vars.trace_lookback_s}",
          "limit": 120
        },
        "timeout": 120
      },
      {
        "id": "summary",
        "name": "实验汇总",
        "action": "measure.summary",
        "timeout": 10
      }
    ]
  },
